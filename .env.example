# Скопировать в .env на сервере и заполнить реальные значения. В git НЕ добавлять.
POSTGRES_USER=redflag
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=redflag

# Антифрод-правила (L1)
RULES_MAX_AMOUNT=100000
RULES_ALLOWED_CURRENCIES=RUB,USD,EUR
RULES_BLOCKED_USERS=
RULES_BLOCKED_IPS=

# L2 velocity
VELOCITY_MAX_PER_USER=10
VELOCITY_MAX_PER_IP=30

# Логи
LOG_LEVEL=info
LOG_FORMAT=json

# Auth API: задать сильный ключ (клиенты шлют X-API-Key). Пусто = auth выключен (только dev).
API_KEY=
# Поведение при деградации Redis/scorer: open (пропустить, reason в вердикте) | closed (эскалация до review)
FAIL_MODE=open
# Внешний ML-scorer (Ф3, опционально): POST транзакции, ответ {"score","decision","reason"}
SCORER_URL=
