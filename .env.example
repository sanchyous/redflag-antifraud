# Скопировать в .env на сервере и заполнить реальные значения. В git НЕ добавлять.
POSTGRES_USER=redflag
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=redflag

# Справочник плана нумерации (реестр Россвязи: ABC-3xx/4xx/8xx.csv, DEF-9xx.csv).
# Каталог на хосте монтируется в контейнер как /data/numplan (только чтение).
NUMPLAN_HOST_DIR=/home/deploy/redflag/data/numplan
NUMPLAN_DIR=/data/numplan

# Необязательно: каталог конфигурации (allowlist.txt, model.json) на хосте -> /data/config.
CONFIG_HOST_DIR=/home/deploy/redflag/config
# ALLOWLIST_FILE=/data/config/allowlist.txt
# MODEL_FILE=/data/config/model.json

# Политика решения. 0 — брать пороги из файла модели.
REVIEW_THRESHOLD=0
BLOCK_THRESHOLD=0
# Сколько независимых сильных сигналов нужно для block (вместе с высоким score).
BLOCK_MIN_SIGNALS=2
# Предел запросов в секунду на скоринг (по X-API-Key, иначе по IP); 0 — выключено.
RATE_LIMIT_RPS=0

# Окна по номерам (в памяти процесса)
WINDOW_MAX_EVENTS=512
WINDOW_MAX_NUMBERS=4000000
SHORT_CALL_SEC=10
FAN_REFRESH_SEC=30
# Отклонять вызовы с started_at дальше этого в будущем, секунд; 0 — не проверять (по умолчанию)
MAX_FUTURE_SKEW_SEC=0

# Доля allow-решений, пишемых в журнал (review и block пишутся всегда)
JOURNAL_ALLOW_SAMPLE=0.01

# Логи. Формат: json (продакшен) | pretty (читаемый, для консоли) | text.
LOG_LEVEL=info
LOG_FORMAT=json
# Какие решения писать в лог как события: flagged (review и block) | all (и allow на уровне debug) | off
LOG_DECISIONS=flagged
# Предел записей в секунду на одно событие (предупреждения и ошибки не ограничиваются)
LOG_RATE_PER_SEC=200

# Auth API: задать сильный ключ (клиенты шлют X-API-Key). Пусто = auth выключен (только dev).
API_KEY=
# true — отказ запуска, если API_KEY пуст (барьер от случайного открытого прода). По умолчанию выключен,
# чтобы не ломать dev-окружения; для боевого стенда рекомендуется true вместе с заполненным API_KEY.
REQUIRE_API_KEY=false
# Поведение при сбое скоринга: open (allow, причина internal_error) | closed (review)
FAIL_MODE=open

# Включить ML-сервис: COMPOSE_PROFILES=ml (нужен доступ к PyPI при сборке образа и модель в ML_MODELS_HOST_DIR).
# COMPOSE_PROFILES=ml
# ML-сервис (стадия 2 каскада, Python: CatBoost + SHAP). Пусто — только линейная стадия ядра.
ML_URL=http://ml:8100
ML_API_KEY=
ML_TIMEOUT_MS=50
ML_BREAKER_FAILS=5
ML_BREAKER_COOLDOWN_SEC=10
# Каталог с моделью ML на хосте (model.cbm + meta.json) -> /models в контейнере ml
ML_MODELS_HOST_DIR=/home/deploy/redflag/models/current
